# Copy to .env on a Windows machine and fill in the values there. Only server/ reads these.
# Never commit .env, and never put a value in this file: git tracks it.
# In the cloud session, set these in the cloud environment instead (docs/v2/contracts.md section 1),
# except ANTHROPIC_API_KEY: the cloud uses CINDIA_ANTHROPIC_API_KEY, because ANTHROPIC_API_KEY would switch Claude Code's billing.
CINDIA_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=
NESSIE_KEY=
ELASTIC_URL=
KIBANA_URL=
ELASTIC_API_KEY=
ELASTIC_AUTH=
APIFY_TOKEN=
APIFY_AUTH=
HF_TOKEN=
SPACETIME_URL=
SPACETIME_DB=
SPACETIME_TOKEN=
CINDIA_MODEL_DIR=
CINDIA_HF_REPO=
PUBLIC_SITE_URL=
